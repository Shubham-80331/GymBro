<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same policy for cloud backup and device-to-device transfer:
     back up everything except the in-progress workout snapshot. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="active_workout.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="active_workout.json" />
    </device-transfer>
</data-extraction-rules>
